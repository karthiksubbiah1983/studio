{
  "entities": {
    "FormTemplate": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FormTemplate",
      "type": "object",
      "description": "Represents a form template created within FormForge.",
      "properties": {
        "title": {
          "type": "string",
          "description": "The name of the form template."
        },
        "ownerId": {
            "type": "string",
            "description": "The UID of the user who owns this template."
        },
        "categoryId": {
            "type": "string",
            "description": "The ID of the category this form belongs to."
        },
        "subCategoryId": {
            "type": "string",
            "description": "The ID of the sub-category this form belongs to."
        },
        "versions": {
          "type": "array",
          "description": "An array of form versions.",
          "items": {
            "$ref": "#/entities/FormVersion"
          }
        }
      },
      "required": [
        "title",
        "ownerId",
        "versions"
      ]
    },
    "FormVersion": {
        "title": "FormVersion",
        "type": "object",
        "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "type": { "type": "string", "enum": ["draft", "published"] },
            "timestamp": { "type": "string", "format": "date-time" },
            "sections": {
                "type": "array",
                "items": { "$ref": "#/entities/Section" }
            },
            "rules": { "type": "array" },
            "workflows": { "type": "array" },
            "configurations": { "type": "array" }
        },
        "required": ["id", "name", "type", "timestamp", "sections"]
    },
    "Section": {
      "title": "Section",
      "type": "object",
      "description": "Represents a section within a form template, grouping related elements.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "displayMode": { "type": "string", "enum": ["default", "accordion"] },
        "popupOnly": { "type": "boolean" },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/entities/FormElement"
          }
        },
        "exposeForValidation": { "type": "boolean" }
      },
      "required": [
        "id",
        "title",
        "elements"
      ]
    },
    "FormElement": {
      "title": "FormElement",
      "type": "object",
      "description": "Represents a single form element (e.g., text input, dropdown) within a section.",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "key": { "type": "string" },
        "label": { "type": "string" },
        "required": { "type": "boolean" },
        "hidden": { "type": "boolean" }
      },
      "required": [
        "id",
        "type",
        "label",
        "required"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/formTemplates/{formTemplateId}": {
        "schema": { "$ref": "#/entities/FormTemplate" },
        "description": "Stores all form templates. Each document has an ownerId field to enforce user-based security rules."
    }
  }
}
