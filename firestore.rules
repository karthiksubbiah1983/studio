rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /formTemplates/{formTemplateId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /userSettings/{userId} {
      allow read, create: if isSignedIn() && isOwner(userId) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isOwner(userId);
    }
  }
}
